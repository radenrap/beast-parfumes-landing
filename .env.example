# Contentful CMS (Content Delivery API)
# Nilai default sudah tertanam di src/config/contentful.js, jadi aplikasi tetap
# berjalan tanpa file .env. Gunakan file ini untuk menimpa kredensial.
VITE_CONTENTFUL_SPACE_ID=CONTENTFUL_SPACE_ID_HERE
VITE_CONTENTFUL_ACCESS_TOKEN=CONTENTFUL_ACCESS_TOKEN_HERE
VITE_CONTENTFUL_ENVIRONMENT=master
VITE_CONTENTFUL_CONTENT_TYPE=parfumes
